# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- MySQL (required for dashboard, sniffer sink, training registration) ---
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=netshield_ai_soc
MYSQL_PORT=3306

# --- Optional: SOC map anchor (public dashboard "home" for threat arcs) ---
# SOC_LAT=17.3850
# SOC_LON=78.4867
# SOC_CITY=Hyderabad

# --- Optional: training data path (default: ./data with *.csv) ---
# TRAINING_DATA_DIR=C:\path\to\your\cicids\csvs
